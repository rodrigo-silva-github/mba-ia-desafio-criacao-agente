# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# O .env NUNCA deve ser versionado.

# Chave da API do Google AI Studio (obrigatória para modelos reais;
# sem chave o sistema usa o modelo fake determinista, para testes offline).
GEMINI_API_KEY=

# Modelo Gemini de cada agente. Consulte a disponibilidade e os limites do
# seu projeto no Google AI Studio. Ordem de grandeza do fluxo de avaliação:
# algumas dezenas de chamadas.
MAIN_MODEL=gemini-2.5-flash
RESERVATIONS_MODEL=gemini-2.5-flash
VISITORS_MODEL=gemini-2.5-flash
REGULATIONS_MODEL=gemini-2.5-flash

# Caminhos dos bancos SQLite em runtime (fora do Git)
SESSIONS_DB_PATH=var/aurora_sessoes.db
BUSINESS_DB_PATH=var/aurora_dados.db