# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# O .env NUNCA deve ser versionado.

# Chave da API do Google AI Studio (obrigatória)
GEMINI_API_KEY=

# Modelo Gemini de cada agente.
# Consulte a disponibilidade e os limites do seu projeto no Google AI Studio.
# Ordem de grandeza do fluxo de avaliacao: algumas dezenas de chamadas.
MODELO_PRINCIPAL=gemini-2.5-flash
MODELO_RESERVAS=gemini-2.5-flash
MODELO_VISITANTES=gemini-2.5-flash
MODELO_REGULAMENTO=gemini-2.5-flash

# Caminhos dos bancos SQLite em runtime (fora do Git)
CAMINHO_BANCO_SESSOES=var/aurora_sessoes.db
CAMINHO_BANCO_DADOS=var/aurora_dados.db