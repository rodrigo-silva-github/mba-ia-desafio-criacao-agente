# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# O .env NUNCA deve ser versionado.
#
# Este arquivo traz só os NOMES das variáveis, sem valores: variável vazia (ou
# ausente) vale como "não informada" e cai no default do código.

# Chave da API do Google AI Studio (obrigatória para modelos reais;
# sem chave o sistema usa o modelo fake determinista, para testes offline).
GEMINI_API_KEY=

# Modelo Gemini de cada agente (default do código: gemini-2.5-flash).
# Consulte a disponibilidade e os limites do seu projeto no Google AI Studio.
# Ordem de grandeza do fluxo de avaliação: algumas dezenas de chamadas.
MAIN_MODEL=
RESERVATIONS_MODEL=
VISITORS_MODEL=
REGULATIONS_MODEL=

# Caminhos dos bancos SQLite em runtime (fora do Git).
# Defaults do código: var/aurora_sessoes.db e var/aurora_dados.db.
SESSIONS_DB_PATH=
BUSINESS_DB_PATH=